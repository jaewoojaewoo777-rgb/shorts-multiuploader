# Copy this file to `.env` and replace every placeholder with your own account.
# Never commit `.env`, SQLite DBs, trace logs, or downloaded videos.

# Required: YouTube source channel. You can use `@handle`, `handle`, or a channel URL.
YOUTUBE_HANDLE=@your-youtube-handle

# Optional: force original-language titles from the channel listing (e.g. ko, ja, en).
# Leave blank to use yt-dlp defaults. Set this when flat extraction returns
# machine-translated titles instead of your channel's original titles.
YOUTUBE_METADATA_LANG=

# Comma-separated upload targets in the order you want them posted.
# Built-in ids: instagram, threads, tiktok, linkedin, facebook, naver
# Remove any platform you do not use. Custom ids are allowed, but you should add
# matching Claude Code skill guidance before live upload.
TARGET_PLATFORMS=instagram,threads,tiktok,linkedin,facebook,naver

# caption = YouTube title plus discovered hashtags. title = title-only text.
POST_TEXT_MODE=caption

# Automation batch selection.
# recent = only the newest missing Shorts in the lookback window.
# all = every missing Short in the lookback window, still capped when
# SHORTS_UPLOAD_LIMIT is a number. Set SHORTS_UPLOAD_LIMIT=all for no cap.
SHORTS_SELECTION_MODE=recent
SHORTS_UPLOAD_LIMIT=2
SHORTS_LOOKBACK_LIMIT=50

# true = skip ad/sponsor-suspected Shorts. false = include them in the batch.
SHORTS_SKIP_ADS=true

# Optional: extra ad/sponsor markers on top of the built-in Korean/English set,
# comma-separated (e.g. AD_MARKERS_EXTRA=#pr,タイアップ,anzeige).
AD_MARKERS_EXTRA=

# Optional creator-owned rules for campaigns, disclosures, and platform limits.
# Copy config/content-policies.example.json to config/content-policies.json, then
# set this value. Leave blank when no exceptional content rules are needed.
CONTENT_POLICIES_FILE=

# --- 코드 업로드(Playwright) 설정 ---
# shared: 한 Chrome 프로필에 모든 플랫폼 로그인(기본, 설정이 가장 간단).
# per-platform: data/profiles/<platform> 프로필 분리.
PROFILE_STRATEGY=shared
SHARED_PROFILE_DIR=data/profiles/shared
# 실제 Chrome 채널을 사용한다(별도 브라우저 다운로드 불필요).
CHROME_CHANNEL=chrome
# true 면 창 없이 실행. 플랫폼 봇 감지를 피하려면 headed(false) 권장.
UPLOADER_HEADLESS=false
# 사람 유사 입력 간격(ms). 0 이면 지연 없음.
UPLOADER_SLOWMO_MS=80

# Required when instagram is enabled.
INSTAGRAM_HANDLE=your_instagram_username

# Optional when threads is enabled. Defaults to INSTAGRAM_HANDLE when blank.
THREADS_HANDLE=

# Optional when tiktok is enabled. Used as a profile-verification hint; TikTok
# Studio is still the primary post-upload verification surface.
TIKTOK_HANDLE=your_tiktok_username

# Optional but recommended when linkedin/facebook are enabled.
LINKEDIN_RECENT_ACTIVITY_URL=https://www.linkedin.com/in/your-profile/recent-activity/all/
FACEBOOK_VIDEOS_URL=https://www.facebook.com/profile.php?id=YOUR_FACEBOOK_PROFILE_OR_PAGE_ID&sk=videos
# Facebook 페이지(Page) 계정으로 게시한다면 페이지 이름을 설정. 업로드 화면에서
# 이 이름이 보이지 않으면(개인 프로필로 게시될 위험) 업로드를 중단한다.
FACEBOOK_PAGE_NAME=

# Required/recommended when naver is enabled. Set either NAVER_CHANNEL_SLUG or
# explicit URLs, and use valid category labels from your Naver Creator Studio.
NAVER_CHANNEL_SLUG=your-naver-creator-channel-slug
NAVER_DASHBOARD_URL=
NAVER_CLIP_URL=
NAVER_CATEGORY_1=
NAVER_CATEGORY_2=

# 로그인 세션 준비: `uv run shorts-dist login <platform>` 으로 프로필을 만들고
# 각 플랫폼에 한 번씩 로그인한 뒤 `uv run shorts-dist doctor` 로 상태를 확인한다.
